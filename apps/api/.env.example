PORT=3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/app_vecinos

# Radio máximo (metros) para considerar detectada una comunidad en GET /comunidades/detectar.
# Ver comentario en src/modulos/geografia/geografia.service.ts: hoy las comunidades solo
# tienen un punto "centro", no un polígono real, así que esto es una aproximación.
RADIO_DETECCION_COMUNIDAD_METROS=3000

# Auth del panel (módulo cuentas). Generar uno propio para cada entorno real, nunca
# reusar este valor de ejemplo: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-real-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h

# Auth de vecinos (app móvil, módulo usuarios). Secreto distinto al de arriba a propósito:
# un token de vecino nunca debe poder usarse como si fuera un token del panel, ni viceversa.
JWT_SECRET_VECINO=cambiar-por-otro-secreto-real-de-al-menos-32-caracteres
JWT_EXPIRES_IN_VECINO=30d

# Índice de búsqueda de negocios (Meilisearch). Ver herramientas/meilisearch/README.md para
# levantarlo localmente — la master key debe ser exactamente la misma en ambos lados.
# Si Meilisearch no está corriendo o falla, la búsqueda cae de vuelta a la consulta directa
# a Postgres (ILIKE) — nunca rompe la app, solo pierde relevancia/tolerancia a errores.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=cambiar-por-la-misma-clave-que-uses-al-arrancar-meilisearch

# Orígenes desde los que se acepta CORS, separados por coma. Sin definir, se usan puertos
# locales típicos de desarrollo (ver main.ts). En producción, poner acá los dominios reales
# de apps/admin y apps/movil — nunca dejarlo abierto a cualquier origen.
CORS_ORIGENES_PERMITIDOS=http://localhost:5183,http://localhost:8081
